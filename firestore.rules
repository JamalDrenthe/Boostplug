rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: orders
// Document ID: {orderId} (alphanumeric string, e.g. random ID or order ID)
// Fields:
//   - id: string (optional, matching document ID or client identifier)
//   - orderNumber: string (optional, formatted order reference e.g. BP-202610-12345)
//   - email: string (required, customer contact email, max 254 chars)
//   - locale: string (optional, 2-10 chars, e.g. 'nl', 'en')
//   - currency: string (optional, 2-10 chars, e.g. 'EUR', 'USD')
//   - items: list (optional, list of purchased cart items, max 100 items)
//   - totalPrice: number (required, total purchase price, >= 0 and <= 1,000,000)
//   - status: string (optional, e.g. 'pending', 'processing', 'shipped', 'delivered', 'cancelled')
//   - deliveryProgress: number (optional, integer 0-100)
//   - trackingToken: string (required, unguessable cross-device tracking token, 4-64 chars)
//   - createdAt: string or timestamp (required, creation timestamp)
//   - syncedAt: string or timestamp (optional, last Firestore sync timestamp)
//   - paidAt: string or timestamp (optional)
//   - deliveredAt: string or timestamp (optional)
//   - updatedAt: string or timestamp (optional)
//
// Collection: subscriptions
// Document ID: {subId} (unique string identifier)
// Fields:
//   - id: string (optional)
//   - planId: string (optional, plan identifier, max 50 chars)
//   - planName: string (optional, plan display name, max 100 chars)
//   - email: string (required, subscriber email, max 254 chars)
//   - monthlyPrice: number (required, monthly recurring price, >= 0 and <= 100,000)
//   - currency: string (optional, 2-10 chars)
//   - status: string (optional, e.g. 'active', 'cancelled')
//   - startedAt: string (optional)
//   - nextBillingAt: string (optional)
//   - syncedAt: string (optional)
//
// Collection: mining_nodes
// Document ID: {userId} (matches member auth UID)
// Fields:
//   - userId: string (required, must match path parameter {userId})
//   - currentStep: number (required, onboarding step number 1-10)
//   - completedSteps: list (optional, completed step indices, max 20 entries)
//   - vvcMemberCode: string (optional, max 50 chars)
//   - xabiWorldUsername: string (optional, max 50 chars)
//   - groverData: map (optional, hardware lease data)
//   - softwareConfig: map (optional, daemon configuration)
//   - zheavenzyArtistId: string (optional, max 50 chars)
//   - logsRentApiKey: string (optional, max 100 chars)
//   - estimatedMonthlyEarnings: number (optional, >= 0)
//   - updatedAt: string (optional)
//   - syncedAt: string (optional)
//
// Collection: vacancies
// Document ID: {vacancyId} (unique string identifier, e.g. vac-eng-01)
// Fields:
//   - id: string (optional, matching document ID, max 100 chars)
//   - title: string (required, vacancy title, 3 to 150 chars)
//   - department: string (required, department name, 2 to 50 chars)
//   - employmentType: string (required, e.g. 'Full-time', 'Freelance / DBA', 2 to 50 chars)
//   - description: string (required, vacancy description, 10 to 5000 chars)
//   - status: string (required, enum: 'active', 'draft', 'closed')
//   - location: string (optional, location up to 100 chars)
//   - salaryRange: string (optional, salary range up to 100 chars)
//   - responsibilities: list (optional, list of string responsibilities, max 30 items)
//   - requirements: list (optional, list of string requirements, max 30 items)
//   - benefits: list (optional, list of string benefits, max 30 items)
//   - tags: list (optional, list of string tags, max 30 items)
//   - niceToHave: list (optional, list of string items, max 30 items)
//   - experienceLevel: string (optional, max 50 chars)
//   - quantumSubholding: string (optional, max 100 chars)
//   - dbaCompliant: bool (optional, whether compliant with DBA guidelines)
//   - djobbaSync: map (optional, synchronization status and payload for Djobba.works)
//   - createdAt: string or timestamp (optional, creation timestamp)
//   - updatedAt: string or timestamp (optional, last update timestamp)
//
// Collection: job_applications
// Document ID: {applicationId} (unique string identifier, e.g. APP-...)
// Fields:
//   - id: string (optional, matching document ID, max 100 chars)
//   - fullName: string (required, applicant full name, 2 to 100 chars)
//   - email: string (required, applicant email address, 5 to 254 chars)
//   - vacancyId: string (required, vacancy ID reference, 3 to 50 chars)
//   - vacancyTitle: string (optional, vacancy title reference, max 150 chars)
//   - phone: string (optional, applicant phone number, max 30 chars)
//   - linkedinUrl: string (optional, LinkedIn profile URL, max 300 chars)
//   - portfolioUrl: string (optional, portfolio or website URL, max 300 chars)
//   - motivation: string (optional, motivation text, max 3000 chars)
//   - dbaStatus: string (optional, e.g. 'zzp', 'loondienst', 'payroll', max 50 chars)
//   - status: string (optional, enum: 'new', 'reviewing', 'interview', 'accepted', 'rejected')
//   - submittedAt: string or timestamp (optional, submission timestamp)
//   - createdAt: string or timestamp (optional)
//
// Fallback:
//   - All other paths restricted strictly to isAdmin()
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email in ['info@boostplug.one', 'info@jamaldrenthe.com'] && request.auth.token.get('email_verified', true) == true) ||
        request.auth.token.get('admin', false) == true
      );
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isValidEmail(email) {
      return email is string &&
             email.size() >= 5 &&
             email.size() <= 254 &&
             email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function isValidOptionalString(mapData, field, minLen, maxLen) {
      return !(field in mapData) ||
             (mapData[field] is string &&
              mapData[field].size() >= minLen &&
              mapData[field].size() <= maxLen);
    }

    function isValidOptionalList(mapData, field, maxSize) {
      return !(field in mapData) ||
             (mapData[field] is list &&
              mapData[field].size() <= maxSize);
    }

    function isValidOptionalMap(mapData, field) {
      return !(field in mapData) || mapData[field] is map;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidOrderCreate(data) {
      return data.totalPrice is number &&
             data.totalPrice >= 0 &&
             data.totalPrice <= 1000000 &&
             data.email is string &&
             isValidEmail(data.email) &&
             data.trackingToken is string &&
             data.trackingToken.size() >= 4 &&
             data.trackingToken.size() <= 64 &&
             isValidOptionalString(data, 'orderNumber', 3, 50) &&
             isValidOptionalString(data, 'status', 2, 30) &&
             isValidOptionalString(data, 'currency', 2, 10) &&
             isValidOptionalString(data, 'locale', 2, 10) &&
             (!('items' in data) || (data.items is list && data.items.size() <= 100)) &&
             (!('deliveryProgress' in data) || (data.deliveryProgress is number && data.deliveryProgress >= 0 && data.deliveryProgress <= 100));
    }

    function isValidOrderUpdate(data) {
      return data.totalPrice is number &&
             data.totalPrice >= 0 &&
             data.totalPrice <= 1000000 &&
             data.email is string &&
             isValidEmail(data.email) &&
             data.trackingToken is string &&
             data.trackingToken.size() >= 4 &&
             data.trackingToken.size() <= 64 &&
             // Onveranderbare velden: trackingToken, orderNumber, id mogen niet muteren
             (!('trackingToken' in resource.data) || data.trackingToken == resource.data.trackingToken) &&
             (!('orderNumber' in resource.data) || !('orderNumber' in data) || data.orderNumber == resource.data.orderNumber) &&
             (!('id' in resource.data) || !('id' in data) || data.id == resource.data.id);
    }

    function isValidSubscription(data) {
      return data.monthlyPrice is number &&
             data.monthlyPrice >= 0 &&
             data.monthlyPrice <= 100000 &&
             data.email is string &&
             isValidEmail(data.email) &&
             isValidOptionalString(data, 'planId', 1, 50) &&
             isValidOptionalString(data, 'planName', 1, 100) &&
             isValidOptionalString(data, 'status', 1, 30) &&
             isValidOptionalString(data, 'currency', 2, 10);
    }

    function isValidMiningNode(data) {
      return data.currentStep is number &&
             data.currentStep >= 1 &&
             data.currentStep <= 10 &&
             (!('completedSteps' in data) || (data.completedSteps is list && data.completedSteps.size() <= 20)) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             isValidOptionalString(data, 'vvcMemberCode', 1, 50) &&
             isValidOptionalString(data, 'xabiWorldUsername', 1, 50) &&
             isValidOptionalString(data, 'zheavenzyArtistId', 1, 50) &&
             isValidOptionalString(data, 'logsRentApiKey', 1, 100) &&
             (!('estimatedMonthlyEarnings' in data) || (data.estimatedMonthlyEarnings is number && data.estimatedMonthlyEarnings >= 0));
    }

    function isValidVacancy(data) {
      return data.title is string &&
             data.title.size() >= 3 &&
             data.title.size() <= 150 &&
             data.department is string &&
             data.department.size() >= 2 &&
             data.department.size() <= 50 &&
             data.employmentType is string &&
             data.employmentType.size() >= 2 &&
             data.employmentType.size() <= 50 &&
             data.description is string &&
             data.description.size() >= 10 &&
             data.description.size() <= 5000 &&
             data.status is string &&
             data.status in ['active', 'draft', 'closed'] &&
             isValidOptionalString(data, 'location', 0, 100) &&
             isValidOptionalString(data, 'salaryRange', 0, 100) &&
             isValidOptionalList(data, 'responsibilities', 30) &&
             isValidOptionalList(data, 'requirements', 30) &&
             isValidOptionalList(data, 'benefits', 30) &&
             isValidOptionalList(data, 'tags', 30) &&
             isValidOptionalList(data, 'niceToHave', 30) &&
             isValidOptionalMap(data, 'djobbaSync') &&
             isValidOptionalString(data, 'id', 0, 100) &&
             isValidOptionalString(data, 'experienceLevel', 0, 50) &&
             isValidOptionalString(data, 'quantumSubholding', 0, 100) &&
             isValidOptionalString(data, 'createdAt', 0, 100) &&
             isValidOptionalString(data, 'updatedAt', 0, 100) &&
             (!('dbaCompliant' in data) || data.dbaCompliant is bool);
    }

    function isValidJobApplication(data) {
      return data.fullName is string &&
             data.fullName.size() >= 2 &&
             data.fullName.size() <= 100 &&
             data.email is string &&
             isValidEmail(data.email) &&
             data.vacancyId is string &&
             data.vacancyId.size() >= 3 &&
             data.vacancyId.size() <= 50 &&
             isValidOptionalString(data, 'vacancyTitle', 0, 150) &&
             isValidOptionalString(data, 'phone', 0, 30) &&
             isValidOptionalString(data, 'linkedinUrl', 0, 300) &&
             isValidOptionalString(data, 'portfolioUrl', 0, 300) &&
             isValidOptionalString(data, 'motivation', 0, 3000) &&
             isValidOptionalString(data, 'id', 0, 100) &&
             isValidOptionalString(data, 'submittedAt', 0, 100) &&
             isValidOptionalString(data, 'createdAt', 0, 100) &&
             isValidOptionalString(data, 'dbaStatus', 0, 50) &&
             (!('status' in data) || (data.status is string && data.status in ['new', 'reviewing', 'interview', 'accepted', 'rejected']));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Bestellingen: gasten en klanten mogen aanmaken, beheerder mag alles
    match /orders/{orderId} {
      allow create: if isValidOrderCreate(request.resource.data);

      // Direct document get: beheerder, order-eigenaar (email), of gast die orderId / token opvraagt
      allow get: if isAdmin() ||
                    (signedIn() && resource.data.email == request.auth.token.email) ||
                    (resource.data.trackingToken is string);

      // Collectie queries: beheerder ziet alles; ingelogde klant mag filteren op eigen email;
      // Gasten mogen UITSLUITEND filteren op hun specifieke trackingToken (bijv. where('trackingToken', '==', token))
      // Brede queries zonder trackingToken filter worden door Firestore afgewezen voor gasten
      allow list: if isAdmin() ||
                     (signedIn() && resource.data.email == request.auth.token.email) ||
                     (resource.data.trackingToken is string);

      allow update: if isAdmin() && isValidOrderUpdate(request.resource.data);
      allow delete: if isAdmin();
    }

    // Abonnementen: aanmaken toegestaan met validatie, beheerder mag alles, klant leest eigen
    match /subscriptions/{subId} {
      allow create: if isValidSubscription(request.resource.data);
      allow read: if isAdmin() || (signedIn() && resource.data.email == request.auth.token.email);
      allow update: if isAdmin() && isValidSubscription(request.resource.data);
      allow delete: if isAdmin();
    }

    // Mining nodes (leden): lid mag uitsluitend het eigen profiel beheren, beheerder mag alles
    match /mining_nodes/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if (isAdmin() || isOwner(userId)) &&
                       isValidMiningNode(request.resource.data) &&
                       (!('userId' in request.resource.data) || request.resource.data.userId == userId);
      allow update: if (isAdmin() || isOwner(userId)) &&
                       isValidMiningNode(request.resource.data) &&
                       (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Vacatures: publiek leesbaar mits actief (of door beheerder); beheer strikt beheerder
    match /vacancies/{vacancyId} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow create: if isAdmin() &&
                       isValidVacancy(request.resource.data) &&
                       (!('id' in request.resource.data) || request.resource.data.id == vacancyId);
      allow update: if isAdmin() &&
                       isValidVacancy(request.resource.data) &&
                       (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
      allow delete: if isAdmin();
    }

    // Sollicitaties: publiek insturen toegestaan met strikte schema-validatie, uitsluitend beheerder leest/beheert
    match /job_applications/{applicationId} {
      allow create: if isValidJobApplication(request.resource.data) &&
                       (!('id' in request.resource.data) || request.resource.data.id == applicationId);
      allow read: if isAdmin();
      allow update: if isAdmin() &&
                       isValidJobApplication(request.resource.data) &&
                       (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
      allow delete: if isAdmin();
    }

    // Fallback voor overige collecties: strikt admin (default deny voor alle anderen)
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
